# Cloudflare Pages: cabeceras HTTP.

# Bloquea indexación y rastreo en todas las URLs (también imágenes, PDF, etc.).
# Quitar estas dos líneas cuando se quiera indexar la web (además de "indexable": true en business.json).
/*
  X-Robots-Tag: noindex, nofollow

# Seguridad básica (sin CSP: el mapa de Google y el formulario de FormSubmit necesitarían una lista blanca)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# CSS con hash en el nombre: se puede cachear un año
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos y logos: una semana (cambian de contenido sin cambiar de nombre)
/img/*
  Cache-Control: public, max-age=604800
