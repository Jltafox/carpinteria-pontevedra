---
import { fill, pageByRoute, phoneLabel, services, telHref } from '../lib/site';

const showProjects = Boolean(pageByRoute('/proyectos/')); // solo si se genera la página (SHOW_PROJECTS)
---
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label={`${fill('{{marca}}')} · inicio`}>
      <img class="brand-logo" src="/img/logo/urexal-sello.webp" alt="" width="48" height="48" />
      <span>{fill('{{marca}}')}</span>
    </a>
    <nav class="nav" aria-label="Principal">
      <details class="menu">
        <summary>Servicios</summary>
        <ul>
          {services.map((s) => <li><a href={s.route}>{s.h1}</a></li>)}
        </ul>
      </details>
      {showProjects && <a href="/proyectos/">Trabajos</a>}
      <a class="tel" href={telHref()}>{phoneLabel()}</a>
      <a class="btn btn-small btn-primary" href="/presupuesto/">Presupuesto</a>
    </nav>
  </div>
</header>
