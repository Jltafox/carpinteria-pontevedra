---
import { biz, fill, hubs, mapsEmbedSrc, phoneLabel, services, telHref } from '../lib/site';

interface Props {
  hideMap?: boolean; // la home ya tiene su bloque «Dónde estamos» con el mapa
}
const { hideMap = false } = Astro.props;
const hasCoords = String(biz.lat ?? '').trim() !== '' && String(biz.lng ?? '').trim() !== '';
// Prioridad: mapa de la ficha de Google; si no existe aún, mapa por coordenadas.
const mapSrc = hideMap ? '' : mapsEmbedSrc() || (hasCoords ? `https://maps.google.com/maps?q=${biz.lat},${biz.lng}&z=15&output=embed` : '');
const hasMap = Boolean(mapSrc);
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="brand">{fill('{{marca}}')}</p>
      <!-- NAP: debe coincidir exactamente con la ficha de Google -->
      <address>
        {fill('{{calle}}')}<br />
        {fill('{{cp}} {{localidad}} ({{provincia}})')}<br />
        <a href={telHref()}>{phoneLabel()}</a><br />
        <a href={`mailto:${fill('{{email}}')}`}>{fill('{{email}}')}</a>
      </address>
      <p class="muted">{biz.horario_texto || fill('{{abre}}–{{cierra}}, de lunes a viernes')}</p>
    </div>
    <div>
      <p class="footer-title">Servicios</p>
      <ul>{services.map((s) => <li><a href={s.route}>{s.h1}</a></li>)}</ul>
    </div>
    <div>
      <p class="footer-title">Zonas</p>
      <ul>
        <li><a href="/">Carpintería en Pontevedra</a></li>
        {hubs.map((h) => <li><a href={h.route}>{h.h1.replace('Carpintería de madera', 'Carpintería')}</a></li>)}
      </ul>
      <p class="footer-title">Información</p>
      <ul>
        <li><a href="/presupuesto/">Pide presupuesto</a></li>
        <li><a href="/sobre-nosotros/">Quiénes somos</a></li>
        <li><a href="/aviso-legal/">Aviso legal</a></li>
        <li><a href="/politica-de-privacidad/">Política de privacidad</a></li>
        <li><a href="/cookies/">Cookies</a></li>
      </ul>
    </div>
  </div>
  {hasMap && (
    <div class="wrap map">
      <iframe title="Mapa de ubicación" src={mapSrc} loading="lazy" width="100%" height="260" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  )}
</footer>
