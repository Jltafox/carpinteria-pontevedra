---
import { quoteHref, telHref, waHref } from '../lib/site';

interface Props {
  servicio?: string;
  zona?: string;
}
const { servicio, zona } = Astro.props;
const quote = quoteHref(servicio, zona);
// Barra fija en móvil: el contacto siempre a mano.
---
<nav class="mobile-cta" aria-label="Contacto rápido">
  <a href={telHref()}>Llamar</a>
  <a href={waHref(servicio)}>WhatsApp</a>
  <a class="primary" href={quote}>Presupuesto</a>
</nav>
