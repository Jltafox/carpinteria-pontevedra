---
import Img from './Img.astro';
import { biz, fill, mapsEmbedSrc, phoneLabel, telHref } from '../lib/site';

interface Props {
  section: any;
  index: number;
}
const { section: s, index } = Astro.props;
const dev = import.meta.env.DEV;
const num = String(index).padStart(2, '0');
const testimonials = biz.testimonios || [];
const mapSrc = s.kind === 'nap' ? mapsEmbedSrc() : '';
const dark = s.kind === 'process';
---
<section class:list={['block', { dark }]} id={s.kind === 'nap' ? 'donde-estamos' : undefined}>
  <div class="wrap">
    <header class="block-head">
      <span class="num">{num}</span>
      <h2>{fill(s.h2)}</h2>
    </header>

    {s.kind === 'text' && (
      <div class="prose">
        {s.paragraphs.map((p: string) => <p>{fill(p)}</p>)}
        {s.list?.length > 0 && (
          <p class="inline-list"><span>{s.list_title}:</span> {s.list.join(' · ')}</p>
        )}
      </div>
    )}

    {s.kind === 'items' && (
      <div class:list={['items', { 'with-images': s.items.some((i: any) => i.image) }]}>
        {s.items.map((item: any) => (
          <article class="item">
            {item.image && <Img image={item.image} class="item-img" />}
            <div>
              <h3>{fill(item.h3)}</h3>
              <p>{fill(item.text)}</p>
            </div>
          </article>
        ))}
      </div>
    )}

    {s.kind === 'process' && (
      <ol class="steps">
        {s.steps.map((step: any) => (
          <li>
            <h3>{step.h3}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    )}

    {s.kind === 'price' && (
      <div class="prose">
        <p>{s.text}</p>
        <h3>Qué influye en el precio</h3>
        <ul class="dash">{s.factors.map((f: string) => <li>{f}</li>)}</ul>
        {biz.publicar_precios && s.ranges?.length > 0 && (
          <table class="prices">
            <caption>Precios orientativos</caption>
            <tbody>
              {s.ranges.map((r: any) => (
                <tr><th scope="row">{r.label}</th><td>{r.value}</td></tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    )}

    {s.kind === 'cards' && (
      <ul class="rows">
        {s.cards.map((c: any) => (
          <li>
            <a class="row" href={c.url}>
              {c.image && <Img image={c.image} class="row-img" />}
              <span class="row-text">
                <span class="row-title">{c.title}</span>
                <span class="row-desc">{c.text}</span>
              </span>
              <span class="row-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    )}

    {s.kind === 'links' && (
      <div class="prose">
        {s.text && <p>{fill(s.text)}</p>}
        {s.links?.length > 0 && (
          <ul class="arrow-links">{s.links.map((l: any) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
        )}
      </div>
    )}

    {s.kind === 'gallery' && (
      <div class="gallery">
        {s.images.map((img: any) => (
          <figure>
            <Img image={img} />
            <figcaption>{img.alt}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {s.kind === 'testimonials' && (testimonials.length > 0 ? (
      <div class="quotes">
        {testimonials.map((t: any) => (
          <blockquote>
            <p>“{t.texto}”</p>
            <footer>{t.nombre}{t.municipio && ` · ${t.municipio}`}</footer>
          </blockquote>
        ))}
        {biz.gbp_url && <p><a href={biz.gbp_url}>Ver todas las opiniones en Google</a></p>}
      </div>
    ) : dev && (
      <p class="placeholder">Añade testimonios reales y con permiso en <code>business.json → testimonios</code> (texto, nombre, municipio). Esta sección no se muestra hasta tenerlos.</p>
    ))}

    {s.kind === 'faq' && (
      <div class="faq">
        {s.faqs.map((f: any) => (
          <details>
            <summary>{fill(f.q)}</summary>
            <p>{fill(f.a)}</p>
          </details>
        ))}
      </div>
    )}

    {s.kind === 'nap' && (
      <div class="nap-grid">
        <div>
          <!-- NAP: idéntico al de la ficha de Google, al pie y al schema -->
          <address class="nap">
            <strong>{fill('{{marca}}')}</strong><br />
            {fill('{{calle}}')}<br />
            {fill('{{cp}} {{localidad}} ({{provincia}})')}<br />
            Tel.: <a href={telHref()}>{phoneLabel()}</a><br />
            Email: <a href={`mailto:${fill('{{email}}')}`}>{fill('{{email}}')}</a>
          </address>
          <p class="muted">Horario: {biz.horario_texto || fill('{{abre}}–{{cierra}}, de lunes a viernes')}</p>
          {biz.gbp_url && <p><a href={biz.gbp_url} rel="noopener">Ver la ficha en Google Maps</a></p>}
        </div>
        {mapSrc ? (
          <iframe class="gbp-map" title={`Ubicación de ${fill('{{marca}}')} en Google Maps`} src={mapSrc} loading="lazy"
            width="600" height="380" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
        ) : (
          <div class="img-slot" style="aspect-ratio: 3 / 2" role="img" aria-label="Mapa pendiente">
            <span class="img-slot-label">Mapa pendiente</span>
            <small>Pega en <code>business.json → maps_embed_url</code> el código de «Compartir → Insertar un mapa» de la ficha.</small>
          </div>
        )}
      </div>
    )}
  </div>
</section>
