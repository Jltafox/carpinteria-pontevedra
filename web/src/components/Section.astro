---
import ConsentMap from './ConsentMap.astro';
import Img from './Img.astro';
import Inline from './Inline.astro';
import { biz, fill, mapsEmbedSrc, phoneLabel, quoteHref, telHref } from '../lib/site';

interface Props {
  section: any;
  index: number;
  servicio?: string;
}
const { section: s, index, servicio } = Astro.props;
const dev = import.meta.env.DEV;
const num = String(index).padStart(2, '0');
const testimonials = biz.testimonios || [];
const mapSrc = s.kind === 'nap' ? mapsEmbedSrc() : '';
const dark = s.kind === 'process';
---
<section class:list={['block', { dark }]} id={s.kind === 'nap' ? 'donde-estamos' : undefined}>
  <div class="wrap">
    <header class="block-head">
      <span class="num">{num}</span>
      <h2>{fill(s.h2)}</h2>
    </header>

    {s.kind === 'text' && (
      <div class="prose">
        {s.paragraphs.map((p: string) => <p>{fill(p)}</p>)}
        {s.list?.length > 0 && (
          <p class="inline-list"><span>{s.list_title}:</span> {s.list.join(' · ')}</p>
        )}
      </div>
    )}

    {s.kind === 'rich' && (
      <div class="prose">
        {s.blocks.map((b: any) =>
          b.type === 'p' ? <p><Inline text={b.text} /></p>
          : b.type === 'ul' ? (
            <ul class="dash">{b.items.map((i: any) => <li>{i.lead && <strong><Inline text={i.lead} />: </strong>}<Inline text={i.text} /></li>)}</ul>
          ) : b.type === 'cta' ? <p class="section-cta"><a class="btn btn-primary" href={quoteHref(servicio)}>{b.label}</a></p>
          : null
        )}
      </div>
    )}

    {s.kind === 'items' && s.intro?.length > 0 && (
      <div class="prose section-intro">
        {s.intro.map((b: any) => b.type === 'ul'
          ? <ul class="dash">{b.items.map((i: any) => <li>{i.lead && <strong><Inline text={i.lead} />: </strong>}<Inline text={i.text} /></li>)}</ul>
          : <p><Inline text={b.text} /></p>)}
      </div>
    )}

    {s.kind === 'items' && (
      <div class:list={['items', { 'with-images': s.items.some((i: any) => i.image) }]}>
        {s.items.map((item: any) => (
          <div class="item">
            {item.image && <Img image={item.image} class="item-img" />}
            <div>
              <h3>{item.url ? <a href={item.url}>{fill(item.h3)}</a> : fill(item.h3)}</h3>
              <p><Inline text={item.text} /></p>
            </div>
          </div>
        ))}
      </div>
    )}

    {s.kind === 'process' && s.intro?.length > 0 && (
      <div class="prose section-intro">{s.intro.map((p: any) => <p><Inline text={p} /></p>)}</div>
    )}

    {s.kind === 'process' && (
      <ol class:list={['steps', { wide: s.steps.length > 4, 'own-numbers': s.steps.every((st: any) => /^\d+[.)]\s/.test(st.h3)) }]}>
        {s.steps.map((step: any) => (
          <li>
            <h3>{fill(step.h3)}</h3>
            <p><Inline text={step.text} /></p>
          </li>
        ))}
      </ol>
    )}

    {s.cta && (s.kind === 'items' || s.kind === 'process') && (
      <p class="section-cta"><a class:list={['btn', s.kind === 'process' ? 'btn-light' : 'btn-primary']} href={quoteHref(servicio)}>{s.cta}</a></p>
    )}

    {s.kind === 'price' && (
      <div class="prose">
        <p>{s.text}</p>
        <h3>Qué influye en el precio</h3>
        <ul class="dash">{s.factors.map((f: string) => <li>{f}</li>)}</ul>
        {biz.publicar_precios && s.ranges?.length > 0 && (
          <table class="prices">
            <caption>Precios orientativos</caption>
            <tbody>
              {s.ranges.map((r: any) => (
                <tr><th scope="row">{r.label}</th><td>{r.value}</td></tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    )}

    {s.kind === 'cards' && (
      <ul class="rows">
        {s.cards.map((c: any) => (
          <li>
            <a class="row" href={c.url}>
              {c.image && <Img image={c.image} class="row-img" />}
              <span class="row-text">
                <span class="row-title">{c.title}</span>
                <span class="row-desc">{c.text}</span>
              </span>
              <span class="row-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    )}

    {s.kind === 'links' && (
      <div class="prose">
        {s.text && <p>{fill(s.text)}</p>}
        {s.links?.length > 0 && (
          <ul class="arrow-links">{s.links.map((l: any) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
        )}
      </div>
    )}

    {s.kind === 'gallery' && (
      <div class="gallery">
        {s.images.map((img: any) => (
          <figure>
            <Img image={img} />
            <figcaption>{img.alt}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {s.kind === 'testimonials' && (testimonials.length > 0 ? (
      <div class="quotes">
        {testimonials.map((t: any) => (
          <blockquote>
            <p>“{t.texto}”</p>
            <footer>{t.nombre}{t.municipio && ` · ${t.municipio}`}</footer>
          </blockquote>
        ))}
        {biz.gbp_url && <p><a href={biz.gbp_url}>Ver todas las opiniones en Google</a></p>}
      </div>
    ) : dev && (
      <p class="placeholder">Añade testimonios reales y con permiso en <code>business.json → testimonios</code> (texto, nombre, municipio). Esta sección no se muestra hasta tenerlos.</p>
    ))}

    {s.kind === 'faq' && (
      <div class="faq">
        {s.faqs.map((f: any) => (
          <details>
            <summary>{fill(f.q)}</summary>
            <p>{fill(f.a)}</p>
          </details>
        ))}
      </div>
    )}

    {s.kind === 'nap' && (
      <div class="nap-grid">
        <div>
          {/* NAP: idéntico al de la ficha de Google, al pie y al schema */}
          <address class="nap">
            <strong>{fill('{{marca}}')}</strong><br />
            {biz.gbp_url ? (
              <a href={biz.gbp_url} rel="noopener">{fill('{{calle}}')}<br />{fill('{{cp}} {{localidad}} ({{provincia}})')}</a>
            ) : (
              <>{fill('{{calle}}')}<br />{fill('{{cp}} {{localidad}} ({{provincia}})')}</>
            )}<br />
            Tel.: <a href={telHref()}>{phoneLabel()}</a><br />
            Email: <a href={`mailto:${fill('{{email}}')}`}>{fill('{{email}}')}</a>
          </address>
          <p class="muted">Horario: {biz.horario_texto || fill('{{abre}}–{{cierra}}, de lunes a viernes')}</p>
        </div>
        {mapSrc ? (
          <ConsentMap class="gbp-map" src={mapSrc} link={biz.gbp_url} title={`Ubicación de ${fill('{{marca}}')} en Google Maps`} />
        ) : (
          <div class="img-slot" style="aspect-ratio: 3 / 2" role="img" aria-label="Mapa pendiente">
            <span class="img-slot-label">Mapa pendiente</span>
            <small>Pega en <code>business.json → maps_embed_url</code> el código de «Compartir → Insertar un mapa» de la ficha.</small>
          </div>
        )}
      </div>
    )}
  </div>
</section>
