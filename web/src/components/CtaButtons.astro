---
import { phoneLabel, quoteHref, telHref, waHref } from '../lib/site';

interface Props {
  servicio?: string;
  zona?: string;
  label?: string;
}
const { servicio, zona, label = 'Pedir presupuesto' } = Astro.props;
const quote = quoteHref(servicio, zona);
---
<div class="ctas">
  <a class="btn btn-primary" href={quote}>{label}</a>
  <a class="btn" href={telHref()}>Llamar · {phoneLabel()}</a>
  <a class="btn btn-wa" href={waHref(servicio)}>WhatsApp</a>
</div>
