---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CtaButtons from './CtaButtons.astro';
import Img from './Img.astro';
import Section from './Section.astro';
import { biz, fill, hasPublicFile } from '../lib/site';

interface Props {
  page: any;
}
const { page } = Astro.props;
// Sin testimonios reales, esa sección no se publica (en desarrollo se ve como recordatorio).
// Las galerías de proyectos solo se publican cuando tienen alguna foto real en public/.
const sections = page.sections.filter(
  (s: any) =>
    import.meta.env.DEV ||
    (s.kind === 'testimonials' ? (biz.testimonios || []).length > 0 : s.kind === 'gallery' ? s.images.some((img: any) => hasPublicFile(img.src)) : true),
);
const eyebrow = page.type === 'hub' ? 'Carpintería de madera · Zona de trabajo'
  : page.type === 'pillar' ? 'Servicio' : 'Carpintería en Pontevedra';
---
<Base page={page}>
  {page.breadcrumbs.length > 0 && <Breadcrumbs items={page.breadcrumbs} />}
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{fill(page.h1)}</h1>
        {page.lead && <p class="lead">{fill(page.lead)}</p>}
        <CtaButtons servicio={page.cta?.servicio} zona={page.cta?.zona} />
      </div>
      {page.hero_image && <Img image={page.hero_image} eager class="hero-img" />}
    </div>
  </section>
  {sections.map((section: any, i: number) => <Section section={section} index={i + 1} />)}
  <section class="cta-final">
    <div class="wrap">
      <h2>¿Hablamos de tu proyecto?</h2>
      <p>Te llamamos en menos de 2 días y visitamos tu vivienda en 3–4 días laborables.</p>
      <CtaButtons servicio={page.cta?.servicio} zona={page.cta?.zona} />
    </div>
  </section>
</Base>
