---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaButtons from '../components/CtaButtons.astro';
import { biz, pageByRoute, services } from '../lib/site';

const page = pageByRoute('/proyectos/');
const projects = biz.proyectos || [];
---
<Base page={page}>
  <Breadcrumbs items={page.breadcrumbs} />
  <section class="hero">
    <div class="wrap">
      <h1>Trabajos realizados</h1>
      <p class="lead">Cocinas, armarios, muebles, rehabilitaciones y carpintería exterior hechos por nuestro equipo.</p>
    </div>
  </section>
  <section class="block">
    <div class="wrap">
      {projects.length > 0 ? (
        <div class="grid">
          {projects.map((p: any) => (
            <figure class="card project">
              {p.imagen && <img src={p.imagen} alt={p.alt || p.titulo} loading="lazy" width="640" height="480" />}
              <figcaption><strong>{p.titulo}</strong>{p.municipio && ` · ${p.municipio}`}<br />{p.texto}</figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <p class="placeholder">Estamos preparando la galería de trabajos. Mientras tanto, pídenos fotos de proyectos parecidos al tuyo.</p>
      )}
      <h2>Nuestros servicios</h2>
      <ul class="pills">{services.map((s) => <li><a href={s.route}>{s.h1}</a></li>)}</ul>
      <CtaButtons />
    </div>
  </section>
</Base>
