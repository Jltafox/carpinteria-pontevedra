---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaButtons from '../components/CtaButtons.astro';
import Img from '../components/Img.astro';
import { pageByRoute, services } from '../lib/site';

const page = pageByRoute('/proyectos/');
// Una galería por servicio: las mismas fotos que la galería de cada página pilar.
const galleries = services.map((s) => ({
  route: s.route,
  name: s.h1,
  images: s.sections.find((x: any) => x.kind === 'gallery')?.images ?? [],
}));
---
<Base page={page}>
  <Breadcrumbs items={page.breadcrumbs} />
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Trabajos realizados</p>
      <h1>Proyectos de carpintería a medida</h1>
      <p class="lead">Cocinas, armarios, muebles, rehabilitaciones y carpintería exterior hechos por nuestro equipo.</p>
    </div>
  </section>
  {galleries.map((g, i) => (
    <section class="block">
      <div class="wrap">
        <header class="block-head">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h2><a href={g.route}>{g.name}</a></h2>
        </header>
        <div class="gallery">
          {g.images.map((img: any) => (
            <figure>
              <Img image={img} />
              <figcaption>{img.alt}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  ))}
  <section class="cta-final">
    <div class="wrap">
      <h2>¿Quieres algo parecido en tu casa?</h2>
      <CtaButtons />
    </div>
  </section>
</Base>
