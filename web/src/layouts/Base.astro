---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { biz, fill, fillDeep, indexable, pending, pruneTokens, siteUrl } from '../lib/site';

interface Props {
  page: any;
}
const { page } = Astro.props;
const title = fill(page.title);
const description = fill(page.description);
const base = siteUrl();
// Sin canonical en páginas que nunca se indexan (legales, 404, confirmación).
const canonical = base && !page.noindex ? base + page.route : undefined;
// Imagen para compartir: la portada de la página o, si no tiene, la imagen general del negocio.
const ogImage = base && page.hero_image ? base + page.hero_image.src : biz.imagen_url || undefined;
const siteName = fill('{{marca}}');
const jsonld = page.jsonld ? JSON.stringify(pruneTokens(fillDeep(page.jsonld))).replace(/</g, '\\u003c') : '';
// La web no se indexa hasta "indexable": true en business.json (y sin datos pendientes).
const noindex = page.noindex || !indexable;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-64.png?v=3" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <meta name="theme-color" content="#1b1915" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {/* Legales: siempre noindex; con la web indexable se siguen sus enlaces (follow) */}
    {noindex && <meta name="robots" content={indexable ? 'noindex, follow' : 'noindex, nofollow'} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={page.hero_image ? page.hero_image.alt : siteName} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {jsonld && <script type="application/ld+json" set:html={jsonld} />}
  </head>
  <body>
    {import.meta.env.DEV && pending.length > 0 && (
      <div class="dev-banner" role="status">
        Faltan datos del negocio en <code>src/data/business.json</code>: {pending.join(', ')}
      </div>
    )}
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <MobileCta servicio={page.cta?.servicio} zona={page.cta?.zona} />
    <CookieConsent />
  </body>
</html>
