{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://{{dominio}}/{{servicio_slug}}/{{zona_slug}}/#servicio",
      "name": "{{servicio}} en {{zona}}",
      "serviceType": "{{servicio_tipo}}",
      "description": "{{meta_description}}",
      "url": "https://{{dominio}}/{{servicio_slug}}/{{zona_slug}}/",
      "provider": {
        "@id": "https://{{dominio}}/#negocio"
      },
      "areaServed": {
        "@type": "City",
        "name": "{{zona}}",
        "containedInPlace": {
          "@type": "AdministrativeArea",
          "name": "Provincia de {{provincia}}"
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://{{dominio}}/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{servicio}}",
          "item": "https://{{dominio}}/{{servicio_slug}}/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "{{zona}}",
          "item": "https://{{dominio}}/{{servicio_slug}}/{{zona_slug}}/"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "{{pregunta}}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{respuesta}}"
          }
        }
      ]
    }
  ]
}
