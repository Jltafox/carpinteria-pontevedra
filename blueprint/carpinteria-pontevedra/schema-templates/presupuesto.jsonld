{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://{{dominio}}/presupuesto/#pagina",
      "name": "Pide presupuesto",
      "url": "https://{{dominio}}/presupuesto/",
      "about": {
        "@id": "https://{{dominio}}/#negocio"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://{{dominio}}/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Pide presupuesto",
          "item": "https://{{dominio}}/presupuesto/"
        }
      ]
    }
  ]
}
